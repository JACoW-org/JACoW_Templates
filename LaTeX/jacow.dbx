%  ┌────────┐
%  │ 3.01.1 │
%  └────────┘
%  - add a new entry type `@preprint' to the data model
%                                                              Zhichu Chen, 30 Jun 2026

%% biblatex-jacow --- A biblatex implementation of the
%% «
%%   JACoW bibliography style
%% »
\ProvidesFile{jacow.dbx}[2026-06-30 JACoW biblatex datamodel style v3.01.1]
%\ProvidesExplFile %«
%    {jacow.dbx}
%    {2026-06-30}
%    {3.01.1}
%    {JACoW biblatex datamodel style} %»

\RequireBiber[3]

\DeclareDatamodelConstant
    [type=list]
    {nameparts}
    {prefix,family,suffix,given}

\DeclareDatamodelEntrytypes{preprint}

\DeclareDatamodelEntryfields[preprint]
{ author
, eprint
, eprintclass
, eprintserver
, eprinttype
, pages
, pubstate
, title
}


\endinput
